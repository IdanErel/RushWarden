{
  "name": "rushwarden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "golden": "pnpm --filter @rushwarden/golden run test:node",
    "clip": "pnpm --filter @rushwarden/clip run clip",
    "golden:browsers": "pnpm --filter @rushwarden/golden run test:browsers",
    "golden:update": "pnpm --filter @rushwarden/golden run update",
    "size": "pnpm --filter @rushwarden/platform-web run build && node tools/size-budget/check.mjs",
    "format": "prettier --write .",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "~4.1.11"
  }
}
