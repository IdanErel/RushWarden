{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rushwarden.com/schema/map.schema.json",
  "title": "Rushwarden map template",
  "description": "One district map template (GDD §3). Rows top to bottom; \".\" block, \"#\" road (1 lane each way), \"B\" road with a bus stop. Edges are inferred at dead ends on the boundary.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^d[1-3]-[0-9]{2}$"
    },
    "district": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "rows": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[.#B]{7}$"
      }
    }
  },
  "required": ["id", "district", "name", "rows"],
  "additionalProperties": false
}
