{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rushwarden.com/schema/deck.schema.json",
  "title": "Rushwarden deck list",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": ["card", "count"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "label", "cards"],
  "additionalProperties": false
}
