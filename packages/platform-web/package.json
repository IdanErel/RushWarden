{
  "name": "@rushwarden/platform-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite web entry with Poki, CrazyGames and itch adapters and the Stripe unlock.",
  "scripts": {
    "lint": "eslint src e2e",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --dir src",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@rushwarden/app": "workspace:*",
    "@rushwarden/backend": "workspace:*",
    "@rushwarden/sim": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "~7.3.7"
  }
}
