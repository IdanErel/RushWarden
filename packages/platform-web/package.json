{
  "name": "@rushwarden/platform-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite web entry with Poki, CrazyGames and itch adapters and the Stripe unlock.",
  "scripts": {
    "lint": "eslint src e2e",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "vite build",
    "build:itch": "VITE_PORTAL=itch vite build",
    "build:poki": "VITE_PORTAL=poki vite build",
    "build:crazygames": "VITE_PORTAL=crazygames vite build",
    "package:itch": "VITE_TEST_HOOKS= VITE_PORTAL=itch vite build --outDir node_modules/.itch-dist --emptyOutDir && node ../../tools/size-budget/check.mjs node_modules/.itch-dist && node scripts/package-itch.mjs",
    "build:e2e": "VITE_TEST_HOOKS=1 vite build --outDir node_modules/.e2e-dist --emptyOutDir",
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test",
    "preview:e2e": "vite preview --outDir node_modules/.e2e-dist --port 4174 --strictPort"
  },
  "dependencies": {
    "@rushwarden/app": "workspace:*",
    "@rushwarden/content": "workspace:*",
    "@rushwarden/render": "workspace:*",
    "@rushwarden/sim": "workspace:*",
    "@rushwarden/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "~7.3.7"
  }
}
